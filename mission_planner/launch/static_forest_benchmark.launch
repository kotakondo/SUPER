<launch>
    <arg name="simulation_number" default="100"/>
    <arg name="drone_config" default="static_forest.yaml"/>
    <arg name="planner_config" default="static_forest.yaml"/>

    <node pkg="perfect_drone_sim" type="perfect_drone" name="perfect_drone" output="log">
        <param name="config_name" value="$(arg drone_config)" type="string"/>
    </node>

    <node pkg="super_planner" name="fsm_node" type="fsm_node" output="screen">
        <param name="config_name" value="$(arg planner_config)" type="string"/>
        <param name="simulation_number" value="$(arg simulation_number)" type="int"/>
    </node>

    <node pkg="rviz" type="rviz" name="top_down"
          args="-d $(find perfect_drone_sim)/rviz/benchmark.rviz" output="log"/>
</launch>
